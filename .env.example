# Copy to .env.local for local development, or set these in Vercel Project Settings.
# All values below are DEMO PLACEHOLDERS. Replace them before connecting a real database.

# Neon PostgreSQL connection string (server-only; never use a VITE_ prefix).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random secret used to hash server-side session tokens. Generate a unique value for each environment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional private Cloudflare R2 storage for transaction receipt images.
# Leave unset to disable remote receipt uploads until configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# App configuration. Use Asia/Kolkata to preserve the current India-focused date handling.
APP_TIME_ZONE=Asia/Kolkata
NODE_ENV=development
